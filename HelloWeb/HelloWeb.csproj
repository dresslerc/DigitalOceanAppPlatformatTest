<Project Sdk="Microsoft.NET.Sdk.Web">

<Target Name="PublishRunWebpack" BeforeTargets="PrepareForPublish">
  <Exec WorkingDirectory="HelloWorld/clientapp" Command="npm install" />
  <Exec WorkingDirectory="HelloWorld/clientapp" Command="npm run build" />
</Target>


  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="9.0.10" />
    <PackageReference Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

</Project>
